<Project Sdk="WixToolset.Sdk/4.0.6">
  <PropertyGroup>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.1.3</ProductVersion>
    <ProductManufacturer Condition="'$(ProductManufacturer)' == ''">UTI DA INFORMATICA LTDA</ProductManufacturer>
    <ApplicationMsiPath Condition="'$(ApplicationMsiPath)' == ''">$(MSBuildProjectDirectory)\bin\msi\Release\SharePointFacil-$(ProductVersion)-x64.msi</ApplicationMsiPath>
    <WinFspMsiPath Condition="'$(WinFspMsiPath)' == ''">$(MSBuildProjectDirectory)\third-party\winfsp\winfsp.msi</WinFspMsiPath>
    <PayloadDir Condition="'$(PayloadDir)' == ''">$(MSBuildProjectDirectory)\build\payload</PayloadDir>

    <OutputType>Bundle</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\bundle\</BaseOutputPath>
    <OutputName>SharePointFacilSetup-$(ProductVersion)-x64</OutputName>
    <DefineConstants>ProductVersion=$(ProductVersion);ProductManufacturer=$(ProductManufacturer);ApplicationMsiPath=$(ApplicationMsiPath);WinFspMsiPath=$(WinFspMsiPath);PayloadDir=$(PayloadDir)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\Bundle.wxs" />
    <PackageReference Include="WixToolset.Bal.wixext" Version="4.0.6" />
  </ItemGroup>
</Project>
